# UAV CTI Lab — Environment Configuration
# Copy this file to .env and change ALL passwords before use
# Research citation: Hevner et al. (2004) Design Science in IS Research

# ── OpenCTI ──────────────────────────────────────────────────────
OPENCTI_ADMIN_EMAIL=admin@uav-cti-lab.local
OPENCTI_ADMIN_PASSWORD=ChangeMe1!
OPENCTI_ADMIN_TOKEN=ChangeMeTokenValue1234567890abcdef
OPENCTI_BASE_URL=http://opencti:8080

# ── MISP ─────────────────────────────────────────────────────────
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_PASSWORD=ChangeMe1!
MISP_BASEURL=http://misp:80
MISP_SALT=ChangeMeSalt1234567890abcdefghij

# ── TheHive / Cortex ─────────────────────────────────────────────
THEHIVE_SECRET=ChangeMe-TheHive-Secret-1234567890
CORTEX_SECRET=ChangeMe-Cortex-Secret-1234567890

# ── Elastic Stack ────────────────────────────────────────────────
ELASTIC_PASSWORD=ChangeMe1!
KIBANA_PASSWORD=ChangeMe1!
ELASTIC_VERSION=8.12.2

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=ChangeMe1!

# ── RabbitMQ (OpenCTI message broker) ────────────────────────────
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=ChangeMe1!

# ── Connector API Keys (optional — for external enrichment) ───────
VT_API_KEY=
OTX_API_KEY=
MISP_CONNECTOR_KEY=

# ── Lab Network ──────────────────────────────────────────────────
LAB_SUBNET=192.168.100.0/24
GCS_LINUX_IP=192.168.100.11
IDS_IP=192.168.100.30
SIEM_IP=192.168.100.40
CTI_IP=192.168.100.50
UAV_SIM_IP=192.168.100.60
