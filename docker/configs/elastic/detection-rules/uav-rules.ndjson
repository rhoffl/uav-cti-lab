## ============================================================
## UAV CTI Lab — Elastic SIEM Detection Rules
## File: docker/configs/elastic/detection-rules/uav-rules.ndjson
##
## 23 KQL-based detection rules aligned to MITRE ATT&CK for ICS.
## Import via Kibana: Security → Rules → Import
##
## Citations:
##   [6]  Rodday et al. (2016) MAVLink vulnerabilities. IEEE NOMS 2016.
##   [7]  Birnbaum et al. (2016) UAV anomaly detection. ICUAS 2016.
##   [10] Strom et al. (2018) MITRE ATT&CK. MITRE MTR180035.
## ============================================================
##
## Each rule below is a valid NDJSON Kibana detection rule object.
## Lines beginning with ## are comments — remove before import.

{"id":"uav-rule-001","name":"[UAV-CTI] MAVLink High-Risk Command from Unknown Source","description":"Detects COMMAND_LONG or SET_MODE MAVLink messages from a source not in the authorized GCS list. Aligns to MITRE ATT&CK T0836 (Modify Parameter). Citation: Rodday et al. 2016 [6].","risk_score":73,"severity":"high","type":"query","query":"event.dataset: zeek_mavlink AND zeek.mavlink.msg_id: (76 OR 11) AND NOT source.ip: (192.168.100.10 OR 192.168.100.11 OR 192.168.100.60)","language":"kuery","tags":["UAV","MAVLink","ATT&CK-T0836"],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0105","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0105/"},"technique":[{"id":"T0836","name":"Modify Parameter","reference":"https://attack.mitre.org/techniques/T0836/"}]}],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-002","name":"[UAV-CTI] MAVLink Sequence Number Gap — Injection Indicator","description":"Detects gaps in MAVLink sequence numbers from the same sys_id, indicating possible packet injection or replay attack. Citation: Birnbaum et al. 2016 [7].","risk_score":61,"severity":"medium","type":"query","query":"event.dataset: zeek_mavlink AND zeek.mavlink.anomaly_type: SEQ_GAP","language":"kuery","tags":["UAV","MAVLink","Injection"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-003","name":"[UAV-CTI] MAVLink Heartbeat Flood — DoS Indicator","description":"Detects rapid heartbeat messages from a single source (>100 per 10s), consistent with a pre-attack denial-of-service pattern against UAV GCS link.","risk_score":55,"severity":"medium","type":"threshold","query":"event.dataset: zeek_mavlink AND zeek.mavlink.msg_name: HEARTBEAT","threshold":{"field":"source.ip","value":100},"language":"kuery","tags":["UAV","DoS","MAVLink"],"enabled":true,"interval":"10m","from":"now-11m","max_signals":100}

{"id":"uav-rule-004","name":"[UAV-CTI] Suricata UAV Custom Rule — High Severity","description":"Any Suricata alert in the custom UAV rule range (SID 9100000-9199999) at severity 1. These are the 47 UAV-specific Suricata rules developed for this research.","risk_score":80,"severity":"high","type":"query","query":"event.dataset: suricata.alert AND rule.id >= 9100000 AND rule.id <= 9199999 AND suricata.eve.alert.severity: 1","language":"kuery","tags":["UAV","Suricata","CTI"],"enabled":true,"interval":"1m","from":"now-2m","max_signals":200}

{"id":"uav-rule-005","name":"[UAV-CTI] CTI IoC Match — Malicious IP Contacted by GCS","description":"GCS host contacted an IP address matching a CTI indicator from OpenCTI/MISP. Auto-populated from CTI feed via cti_to_suricata.py. MITRE T0862 Supply Chain Compromise.","risk_score":90,"severity":"critical","type":"query","query":"event.dataset: suricata.alert AND rule.id >= 9200000 AND (source.ip: 192.168.100.10 OR source.ip: 192.168.100.11)","language":"kuery","tags":["UAV","CTI-IoC","C2","Critical"],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0111","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0111/"}}],"enabled":true,"interval":"1m","from":"now-2m","max_signals":100}

{"id":"uav-rule-006","name":"[UAV-CTI] GPS Anomaly — Possible Spoofing Detected","description":"GPSD reports an anomalous position jump or abnormal satellite signal strength, consistent with GPS spoofing. Citation: Humphreys et al. 2008 [13]. MITRE T0856.","risk_score":85,"severity":"high","type":"query","query":"event.dataset: gpsd_anomaly OR (event.dataset: zeek_mavlink AND zeek.mavlink.msg_name: GLOBAL_POSITION_INT AND zeek.mavlink.anomaly: *)","language":"kuery","tags":["UAV","GPS","Spoofing","ATT&CK-T0856"],"enabled":true,"interval":"2m","from":"now-3m","max_signals":100}

{"id":"uav-rule-007","name":"[UAV-CTI] GCS Process Launching Suspicious Child Process","description":"Mission Planner or QGroundControl spawning cmd.exe, powershell.exe, or a network tool — indicator of GCS malware execution. Citation: CISA ICS Advisory ICSA-22-131-01 [15].","risk_score":78,"severity":"high","type":"query","query":"event.dataset: (windows.process OR sysmon) AND process.parent.name: (MissionPlanner.exe OR QGroundControl.exe) AND process.name: (cmd.exe OR powershell.exe OR wscript.exe OR certutil.exe OR mshta.exe)","language":"kuery","tags":["UAV","GCS","Malware","Windows"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-008","name":"[UAV-CTI] GCS Registry Persistence — Run Key Modification","description":"Modification of Windows Run or RunOnce registry keys by a GCS-related process, indicating malware persistence mechanism. MITRE T0859 Valid Accounts.","risk_score":70,"severity":"high","type":"query","query":"event.dataset: (windows.registry OR sysmon) AND registry.path: (*\\\\CurrentVersion\\\\Run* OR *\\\\CurrentVersion\\\\RunOnce*) AND process.name: (MissionPlanner.exe OR QGroundControl.exe OR python.exe OR dronekit*)","language":"kuery","tags":["UAV","Persistence","Registry"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-009","name":"[UAV-CTI] MAVLink Telemetry to Non-Standard Port (Exfil)","description":"MAVLink telemetry magic bytes (0xFE or 0xFD) observed in traffic to a non-standard destination port, suggesting data exfiltration.","risk_score":72,"severity":"high","type":"query","query":"event.dataset: suricata.alert AND rule.id: 9100022","language":"kuery","tags":["UAV","Exfiltration","MAVLink"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-010","name":"[UAV-CTI] GCS Beaconing Pattern — Regular Small Outbound","description":"GCS host generating regular small outbound connections consistent with C2 beacon behaviour. Threshold: 5+ connections per minute, payload 50-200 bytes.","risk_score":65,"severity":"medium","type":"threshold","query":"event.dataset: suricata.alert AND rule.id: 9100021","threshold":{"field":"source.ip","value":5},"language":"kuery","tags":["UAV","C2","Beacon"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":100}

{"id":"uav-rule-011","name":"[UAV-CTI] MAVLink IDS — UNAUTHORIZED_COMMAND Alert","description":"Custom MAVLink IDS service (mavlink_ids.py) detected an unauthorized high-risk command message from an unrecognized system ID.","risk_score":82,"severity":"high","type":"query","query":"event.dataset: mavlink_ids AND alert_type: UNAUTHORIZED_COMMAND","language":"kuery","tags":["UAV","MAVLink-IDS","Unauthorized"],"enabled":true,"interval":"1m","from":"now-2m","max_signals":200}

{"id":"uav-rule-012","name":"[UAV-CTI] MAVLink IDS — CTI IoC IP Match","description":"MAVLink IDS confirmed source IP matches an OpenCTI indicator. Highest confidence detection — source is known malicious infrastructure.","risk_score":95,"severity":"critical","type":"query","query":"event.dataset: mavlink_ids AND alert_type: CTI_IOC_MATCH","language":"kuery","tags":["UAV","CTI-IoC","Critical","MAVLink-IDS"],"enabled":true,"interval":"1m","from":"now-2m","max_signals":200}

{"id":"uav-rule-013","name":"[UAV-CTI] Firmware Download from Unofficial Source","description":"GCS making HTTP/HTTPS request for .apj firmware file from a non-approved server. Indicates possible supply chain attack. MITRE T0839.","risk_score":75,"severity":"high","type":"query","query":"event.dataset: suricata.alert AND rule.id: (9100040 OR 9100041)","language":"kuery","tags":["UAV","Supply-Chain","Firmware","ATT&CK-T0839"],"enabled":true,"interval":"10m","from":"now-11m","max_signals":100}

{"id":"uav-rule-014","name":"[UAV-CTI] Zeek MAVLink High-Risk Message Tagged","description":"Zeek MAVLink analyzer tagged a message as high-risk (msg_id in monitored set). Correlates with known attack technique mappings.","risk_score":58,"severity":"medium","type":"query","query":"event.dataset: zeek_mavlink AND tags: mavlink-high-risk","language":"kuery","tags":["UAV","Zeek","MAVLink"],"enabled":true,"interval":"5m","from":"now-6m","max_signals":500}

{"id":"uav-rule-015","name":"[UAV-CTI] Multiple Suricata UAV Rules in 60s — Coordinated Attack","description":"Three or more distinct UAV-specific Suricata rules firing within 60 seconds from the same source — indicator of a coordinated multi-technique attack.","risk_score":88,"severity":"critical","type":"threshold","query":"event.dataset: suricata.alert AND rule.id >= 9100000","threshold":{"field":"source.ip","value":3,"cardinality":[{"field":"rule.id","value":3}]},"language":"kuery","tags":["UAV","Coordinated","Critical"],"enabled":true,"interval":"2m","from":"now-3m","max_signals":50}
